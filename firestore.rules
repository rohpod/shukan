rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return signedIn() && request.auth.uid == resource.data.uid;
    }

    function ownsIncoming() {
      return signedIn() && request.auth.uid == request.resource.data.uid;
    }

    // A missing doc must read as "not found", not "permission denied", so the
    // client can tell a deleted list from a forbidden one.
    function canGet() {
      return signedIn() && (resource == null || resource.data.uid == request.auth.uid);
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function ownsList(listId) {
      let path = /databases/$(database)/documents/lists/$(listId);
      return existsAfter(path) && getAfter(path).data.uid == request.auth.uid;
    }

    // Field checks run only on `keys`, so documents written before these rules
    // existed stay editable as long as the fields being changed are valid.
    function validString(d, keys, key, maxSize) {
      return !(key in keys) || (d[key] is string && d[key].size() <= maxSize);
    }

    function validOptionalTimestamp(d, keys, key) {
      return !(key in keys) || d[key] == null || d[key] is timestamp;
    }

    function validTaskFields(d, keys) {
      return keys.hasOnly([
          'taskId', 'uid', 'listId', 'title', 'notes', 'url', 'priority', 'tagIds',
          'dueDate', 'dueTime', 'earlyReminderMinutes', 'repeatRule',
          'repeatCustomConfig', 'repeatAnchorDay', 'order', 'subtasks',
          'createdAt', 'completedAt', 'deletedAt'
        ])
        && validString(d, keys, 'title', 500)
        && (!('title' in keys) || d.title.size() > 0)
        && validString(d, keys, 'notes', 10000)
        && validString(d, keys, 'url', 2048)
        && (!('priority' in keys) || d.priority in ['none', 'low', 'medium', 'high'])
        && (!('tagIds' in keys) || (d.tagIds is list && d.tagIds.size() <= 50))
        && validOptionalTimestamp(d, keys, 'dueDate')
        && (!('dueTime' in keys) || d.dueTime == null
            || (d.dueTime is string && d.dueTime.size() <= 5))
        && (!('earlyReminderMinutes' in keys)
            || (d.earlyReminderMinutes is number && d.earlyReminderMinutes >= 0))
        && (!('repeatRule' in keys)
            || d.repeatRule in ['none', 'daily', 'weekly', 'monthly', 'custom'])
        && (!('repeatCustomConfig' in keys) || d.repeatCustomConfig == null
            || d.repeatCustomConfig is map)
        && (!('repeatAnchorDay' in keys) || d.repeatAnchorDay == null
            || d.repeatAnchorDay is int)
        && (!('order' in keys) || d.order is number)
        && (!('subtasks' in keys) || (d.subtasks is list && d.subtasks.size() <= 200))
        && validOptionalTimestamp(d, keys, 'completedAt')
        && validOptionalTimestamp(d, keys, 'deletedAt');
    }

    function validListFields(d, keys) {
      return keys.hasOnly(['listId', 'uid', 'name', 'createdAt', 'isDefault', 'icon'])
        && validString(d, keys, 'name', 100)
        && (!('name' in keys) || d.name.size() > 0)
        && (!('icon' in keys) || d.icon == null || (d.icon is string && d.icon.size() <= 64));
    }

    function validTagFields(d, keys) {
      return keys.hasOnly(['tagId', 'uid', 'name', 'createdAt'])
        && validString(d, keys, 'name', 100)
        && (!('name' in keys) || d.name.size() > 0);
    }

    match /lists/{listId} {
      allow get: if canGet();
      allow list: if ownsExisting();
      // A default list may only be created together with the user doc naming it.
      allow create: if ownsIncoming()
        && request.resource.data.listId == listId
        && request.resource.data.isDefault is bool
        && validListFields(request.resource.data, request.resource.data.keys())
        && (request.resource.data.isDefault == false
            || getAfter(userPath()).data.defaultListId == listId);
      allow update: if ownsExisting()
        && !changedKeys().hasAny(['uid', 'listId', 'isDefault', 'createdAt'])
        && validListFields(request.resource.data, changedKeys());
      // The default list only goes away with the account itself.
      allow delete: if ownsExisting()
        && (resource.data.isDefault == false || !existsAfter(userPath()));
    }

    match /tasks/{taskId} {
      allow get: if canGet();
      allow list: if ownsExisting();
      allow create: if ownsIncoming()
        && request.resource.data.taskId == taskId
        && 'title' in request.resource.data
        && ownsList(request.resource.data.listId)
        && validTaskFields(request.resource.data, request.resource.data.keys());
      allow update: if ownsExisting()
        && !changedKeys().hasAny(['uid', 'taskId', 'createdAt'])
        && (!('listId' in changedKeys()) || ownsList(request.resource.data.listId))
        && validTaskFields(request.resource.data, changedKeys());
      allow delete: if ownsExisting();
    }

    match /tags/{tagId} {
      allow get: if canGet();
      allow list: if ownsExisting();
      allow create: if ownsIncoming()
        && request.resource.data.tagId == tagId
        && 'name' in request.resource.data
        && validTagFields(request.resource.data, request.resource.data.keys());
      allow update: if ownsExisting()
        && !changedKeys().hasAny(['uid', 'tagId', 'createdAt'])
        && validTagFields(request.resource.data, changedKeys());
      allow delete: if ownsExisting();
    }

    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && !changedKeys().hasAny(['uid', 'createdAt']);
    }
  }
}
